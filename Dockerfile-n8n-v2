# ==============================================================================
# n8n v2 custom image with Limescape Docs runtime dependencies.
# The release script resolves N8N_NODE_BUILDER_IMAGE from the matching upstream
# n8n tag, keeping Node and Alpine ABI-compatible across n8n upgrades.
# ==============================================================================

ARG N8N_VERSION=2.38.1
ARG N8N_NODE_BUILDER_IMAGE=node:26.7.0-alpine3.24
ARG LIMESCAPE_DOCS_VERSION=1.23.0

# ==============================================================================
# STAGE 1: Document Runtime Dependencies
# ==============================================================================
FROM ${N8N_NODE_BUILDER_IMAGE} AS document-deps

ENV LANG=en_US.UTF-8
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV PATH="$JAVA_HOME/bin:$PATH"

RUN apk add --no-cache \
    ghostscript \
    libreoffice \
    openjdk21-jre-headless \
    fontconfig \
    ttf-dejavu \
    ttf-liberation \
    ffmpeg \
    poppler-utils

# ==============================================================================
# STAGE 2: Community Node Build
# Native modules must be built against the exact Node/Alpine combination used
# by the selected n8n release. The compiler remains out of the final image.
# ==============================================================================
FROM document-deps AS community-nodes

ARG LIMESCAPE_DOCS_VERSION

RUN apk add --no-cache python3 make g++

WORKDIR /home/node/.n8n/nodes

COPY n8n-nodes-limescape-docs-${LIMESCAPE_DOCS_VERSION}.tgz ./
COPY limescape-docs-${LIMESCAPE_DOCS_VERSION}.tgz ./

RUN echo "dangerously-allow-all-scripts=true" > .npmrc && \
    echo "allow-remote=all" >> .npmrc && \
    npm install --legacy-peer-deps https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz --loglevel verbose && \
    npm install --legacy-peer-deps ./limescape-docs-${LIMESCAPE_DOCS_VERSION}.tgz --loglevel verbose && \
    npm install --legacy-peer-deps ./n8n-nodes-limescape-docs-${LIMESCAPE_DOCS_VERSION}.tgz --loglevel verbose && \
    npm install --legacy-peer-deps @langfuse/n8n-nodes-langfuse --loglevel verbose && \
    npm install --legacy-peer-deps n8n-nodes-eml --loglevel verbose && \
    npm install --legacy-peer-deps n8n-nodes-run-node-with-credentials-x --loglevel verbose && \
    rm -rf /root/.npm /home/node/.n8n/nodes/*.tgz .npmrc

# ==============================================================================
# STAGE 3: Official n8n Runtime
# ==============================================================================
FROM docker.n8n.io/n8nio/n8n:${N8N_VERSION} AS runtime

USER root

COPY --from=document-deps /usr/bin /usr/bin
COPY --from=document-deps /usr/lib /usr/lib
COPY --from=document-deps /usr/share /usr/share
COPY --from=document-deps /etc/fonts /etc/fonts
COPY --from=community-nodes /home/node/.n8n/nodes /home/node/.n8n/nodes

RUN npm i -g langfuse-langchain --loglevel verbose && \
    ln -s /usr/local/lib/node_modules/n8n/node_modules/n8n-workflow /home/node/.n8n/nodes/node_modules/n8n-workflow && \
    chown -R node:node /home/node/.n8n

WORKDIR /home/node
USER node
COPY ai-ktl.jpg .
